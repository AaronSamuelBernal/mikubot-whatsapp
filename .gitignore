
# ==========================================
# MikuBot - Git Ignore
# ==========================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
coverage/
.nyc_output/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Sesiones y autenticación de WhatsApp (Baileys)
session/
sessions/
auth_info/
auth/
creds.json
**/creds.json
**/app-state-sync-key-*.json

# Historial de conversaciones
history.json
history-*.json
chat-history/
conversations/

# Cachés de noticias y memes
news-cache.json
memes-cache.json
reddit-state.json
**/reddit-state.json

# Biblioteca de imágenes descargadas
images/*
!images/.gitkeep

# Archivos temporales
tmp/
temp/
cache/
*.tmp
*.temp
*.bak
*.swp
*~

# Logs
logs/
*.log
*.log.*
pm2.log

# PM2
.pm2/
pids/
*.pid
*.pid.lock

# Archivos del sistema
.DS_Store
Thumbs.db
Desktop.ini

# IDE y editores
.vscode/
.idea/
*.code-workspace

# Python (scripts auxiliares)
__pycache__/
*.pyc
.venv/
venv/

# Tests y cobertura
coverage/
test-results/

# Datos locales
data/local/
backups/
